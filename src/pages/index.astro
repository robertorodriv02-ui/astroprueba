---
import Layout from "../layouts/Layout.astro";

export interface ProductResponse {
  page: number;
  previous: string | null;
  next: string | null;
  result: Product[];
}

export interface Product {
  id: number;
  image: string;
  details?: string;
  category_id: number;
  category: {
    id: number;
    name: string;
  };
  name: string;
  price: number;
  available: boolean;
  amount: number;
}

const products: ProductResponse = await fetch(
  "http://127.0.0.1:8000/products/",
).then((res) => res.json());
---

<Layout title="Home">
  <main class="productmain-main">
    <h1>Home</h1>
    {
      products.result.map((product) => (
        <section class="producto-card">
          <div class="productoadmin-header">
            <h3> {product.name} </h3>
          </div>
          <p style={{ color: "#ff0000" }}>
            {!product.available ? "Agotado" : ""}
          </p>
          <img
            src={product.image}
            class="producto-img"
            alt={product.name}
            loading="lazy"
          />
          <div class="producto-text">
            <div class="producto-textshort">
              <p class="producto-categ">{product.category.name}</p>
              <p class="producto-price"> ${product.price} </p>
            </div>
            <p class="producto-name"> {product.name} </p>
            <p class="producto-detail"> {product.details} </p>
          </div>
        </section>
      ))
    }
  </main>

  <style>
    .productmain-main {
      padding: 0 10px;
    }

    .producto-card {
      width: 100%;
      max-width: 400px;
    }

    .producto-img {
      width: 100%;
      border-radius: 10px;
    }

    .productoadmin-header {
      margin: 10px 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .producto-text {
      margin: 10px auto;
      background-color: rgba(0, 0, 0, 0.082);
      padding: 10px;
      border-radius: 10px;
    }

    .producto-textshort {
      display: flex;
      justify-content: space-between;
    }

    .producto-price,
    .producto-name {
      font-weight: 600;
    }

    .producto-price {
      color: var(--PRIMARY);
    }

    .producto-detail {
      padding: 0 5px;
      margin-top: 10px;
      color: var(--SOFTWORDS);
    }

    .producto-noid {
      width: fit-content;
      margin: 50px auto;
      font-size: 20px;
    }

    .producto-link {
      display: block;
      margin: 0 auto;
      width: fit-content;
      color: white;
      text-decoration: none;
      background-color: var(--PRIMARY);
      padding: 5px 8px 7px 8px;
      border-radius: 4px;
    }
    .producto-link:hover {
      background-color: var(--HOVER);
    }

    .producto-categ {
      font-size: 14px;
      text-transform: uppercase;
      color: var(--CATEG);
      margin-bottom: 10px;
    }

    .producto-caradd {
      background-color: var(--PRIMARY);
      color: white;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 5px 10px;
      border: none;
      border-radius: 8px;
      width: 100%;
      max-width: 400px;
      gap: 10px;
    }
    .producto-caradd:hover {
      background-color: var(--HOVER);
    }
  </style>
</Layout>
